# Daybook Environment Configuration Template
# Real secrets belong in Cloudflare Worker secrets or local .env (never commit .env)

ENVIRONMENT=local

# Session & Auth
SESSION_SECRET=dev-session-secret-at-least-32-chars-long
FIREBASE_PROJECT_ID=placeholder-firebase-project-id

# Web Client Firebase Configuration
VITE_FIREBASE_API_KEY=placeholder-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=placeholder-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=placeholder-firebase-project-id
VITE_FIREBASE_APP_ID=placeholder-firebase-app-id

# Telegram Channel
TELEGRAM_BOT_TOKEN=placeholder-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=placeholder-telegram-webhook-secret

# Model Providers (Workspace-shared or development fallbacks)
GEMINI_API_KEY=placeholder-gemini-api-key
OPENCODE_GO_API_KEY=placeholder-opencode-go-api-key
