{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daybook",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daybook-db",
      "database_id": "placeholder-d1-eu-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "daybook-storage",
      "jurisdiction": "eu"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_ACTOR",
        "class_name": "WorkspaceActor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceActor"]
    }
  ]
}
