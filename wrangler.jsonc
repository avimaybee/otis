{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otis",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AGENT_MAX_DAILY_ACTIONS": "200",
    "AGENT_MAX_ROUNDS_PER_RUN": "20"
  },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otis-db",
      "database_id": "a7d08779-b61e-4717-b8f2-e63726edab08",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "otis-storage",
      "jurisdiction": "eu"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_ACTOR",
        "class_name": "WorkspaceActor"
      }
    ]
  },
  "queues": {
    "producers": [{ "binding": "DISPATCH_QUEUE", "queue": "otis-dispatch" }],
    "consumers": [{ "queue": "otis-dispatch", "max_batch_size": 10, "max_retries": 5 }]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceActor"]
    }
  ]
}
