{
  "name": "otis-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build && tsc --build && wrangler deploy --dry-run --outdir dist-worker",
    "dev": "concurrently -k -p \"[{name}]\" -n \"worker,web\" -c \"yellow.bold,cyan.bold\" \"wrangler dev --port 8787\" \"vite\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "vite"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/runner": "4.1.0",
    "@vitest/snapshot": "4.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.20.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^3.109.2"
  }
}
